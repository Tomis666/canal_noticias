digraph UML {
graph [rankdir=TB, nodesep=0.55, ranksep=0.95, fontname="Helvetica", pad=0.3, bgcolor="white"];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=10, color="#34495E"];
Persona [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FDEBD0"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B><I>Persona</I></B><BR/>&lt;&lt;abstracta&gt;&gt;</FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ nombre: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ correo: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ habilitado: int</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ descripcion(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Usuario</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ contrasena: str (hash)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ rol: Rol</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ descripcion(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Lector [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Lector</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"> </TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ descripcion(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Rol [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Rol</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ nombre: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ permisos: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ habilitado: int</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"> </TD></TR></TABLE></TD></TR></TABLE>>];
Autor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Autor</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ biografia: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ usuario: Usuario</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ habilitado: int</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ nombre: str  (del usuario)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ descripcion(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Articulo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Articulo</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ titulo: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ contenido: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ fecha_publicacion: date</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ autor: Autor</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ categoria: Categoria</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ estado: EstadoArticulo</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ habilitado: int</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"> </TD></TR></TABLE></TD></TR></TABLE>>];
Categoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Categoria</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ nombre: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ habilitado: int</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"> </TD></TR></TABLE></TD></TR></TABLE>>];
Etiqueta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Etiqueta</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ nombre: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ habilitado: int</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"> </TD></TR></TABLE></TD></TR></TABLE>>];
EstadoArticulo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>EstadoArticulo</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ estado: str</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"> </TD></TR></TABLE></TD></TR></TABLE>>];
Interaccion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FDEBD0"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B><I>Interaccion</I></B><BR/>&lt;&lt;abstracta&gt;&gt;</FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ lector: Lector</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ articulo: Articulo</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ fecha: date</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ resumen(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Comentario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Comentario</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ contenido: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ habilitado: int</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ resumen(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Like [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Like</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"> </TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ resumen(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Plan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Plan</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ nombre: str</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ precio: decimal</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ duracion_dias: int</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ habilitado: int</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"> </TD></TR></TABLE></TD></TR></TABLE>>];
Suscripcion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF2F8"><TR><TD BGCOLOR="#1F3A5F"><FONT COLOR="white"><B>Suscripcion</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BORDER="0">+ lector: Lector</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ plan: Plan</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ fecha_inicio: date</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ fecha_fin: date</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">+ estado: ACTIVA|VENCIDA|CANCELADA</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0"><TR><TD BORDER="0"> </TD></TR></TABLE></TD></TR></TABLE>>];
Usuario -> Persona [arrowhead=empty, color="#C0392B", penwidth=1.6];
Lector -> Persona [arrowhead=empty, color="#C0392B", penwidth=1.6];
Comentario -> Interaccion [arrowhead=empty, color="#C0392B", penwidth=1.6];
Like -> Interaccion [arrowhead=empty, color="#C0392B", penwidth=1.6];
Usuario -> Rol [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, labelangle=25];
Autor -> Usuario [arrowhead=vee, taillabel="0..1", headlabel="1", labeldistance=2.2, labelangle=25];
Articulo -> Autor [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, labelangle=25];
Articulo -> Categoria [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, labelangle=25];
Articulo -> EstadoArticulo [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, labelangle=25];
Articulo -> Etiqueta [arrowhead=vee, taillabel="*", headlabel="*", labeldistance=2.2, labelangle=25];
Interaccion -> Lector [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, labelangle=25];
Interaccion -> Articulo [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, labelangle=25];
Suscripcion -> Lector [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, labelangle=25];
Suscripcion -> Plan [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, labelangle=25];
labelloc=t; label=<<B>Canal de Noticias - Diagrama de clases</B><BR/><FONT POINT-SIZE="10">Rojo: herencia (Persona y Interaccion). Azul: asociaciones. Las clases abstractas no tienen tabla propia.</FONT>>; fontsize=16;
}